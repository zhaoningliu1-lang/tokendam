{
  "name": "tokendam",
  "version": "0.1.0",
  "description": "A linter for your LLM token spend. Paste your agent's trace, see exactly where you're burning tokens — and how to stop. Runs 100% in your browser, nothing uploaded.",
  "type": "module",
  "bin": {
    "tokendam": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/core/index.js",
    "./capture": "./dist/capture.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "cli": "tsx src/cli.ts",
    "build:cli": "tsc -p tsconfig.cli.json",
    "dev": "vite",
    "build:web": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/detectors.test.mjs && tsx test/formats.test.mjs && tsx test/ci.test.mjs && tsx test/capture.test.mjs && tsx test/web-smoke.mjs"
  },
  "keywords": [
    "llm",
    "tokens",
    "cost",
    "openai",
    "anthropic",
    "claude",
    "agent",
    "prompt-caching",
    "observability"
  ],
  "author": "Johnson Liu",
  "license": "MIT",
  "dependencies": {
    "gpt-tokenizer": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "jsdom": "^29.1.1",
    "picocolors": "^1.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
